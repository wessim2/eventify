# =============================================================================
# Eventify — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Superuser connection (used by Prisma migrations — bypasses RLS)
DATABASE_URL="postgresql://eventify_admin:secret@localhost:5432/eventify?schema=public"
# Application-level connection (used by API at runtime — subject to RLS)
DATABASE_APP_URL="postgresql://eventify_app:secret@localhost:5432/eventify?schema=public"

# Postgres credentials (matches docker-compose.yml)
POSTGRES_USER=eventify_admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=eventify
POSTGRES_APP_USER=eventify_app
POSTGRES_APP_PASSWORD=secret

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
# How often the event lifecycle worker runs (in milliseconds)
EVENT_LIFECYCLE_INTERVAL_MS=900000
